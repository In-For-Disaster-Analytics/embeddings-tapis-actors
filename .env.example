# embeddings-tapis-actors -- environment configuration
#
# Copy to .env for local dev (never commit the real .env -- see .gitignore).
# None of these point at anything live yet -- see README "Status: skeleton
# only". Values below are placeholders illustrating the expected shape.

# ---------------------------------------------------------------------------
# embeddingsdb -- Postgres+PostGIS+pgvector Tapis Pod (Decision 26)
# ---------------------------------------------------------------------------
# Deliberately separate from WebODM's own "webodm_dev" database -- see the
# design spec's Assumptions and Decision 26 ("Zero WebODM-database schema
# changes"). Both Actors connect here to read/write tile_observations,
# embeddings, covariates, labels, models, model_inputs, predictions.
#
# LIVE as of 2026-07-23 -- see README "Status" for how it was actually
# provisioned (Tapis's "17postgis3.5" template + install_pgvector.py, not
# the custom pgvector/pgvector:pg16 image originally planned). Host/port
# shape below is the REAL, confirmed-via-psql value, not a docs-derived
# guess (an earlier version of this file predicted a "-postgres" hostname
# suffix that turned out not to match reality -- see
# tapis/register_pod.py's pod_hostname() docstring for the correction).
# Value below is still a placeholder (real password redacted) -- see .env
# for the actual value, never committed.
EMBEDDINGSDB_URL=postgresql://user:password@embeddingsdb.pods.portals.tapis.io:443/embeddingsdb?sslmode=require

# ---------------------------------------------------------------------------
# MLflow -- experiment tracking + model registry Tapis Pod (Decision 17)
# ---------------------------------------------------------------------------
# model-train's own tracking URI. Named to match WebODM's Django-side setting
# of the same purpose (WO_MLFLOW_TRACKING_URI in webodm/settings.py) --
# WebODM's diagnostics-proxy endpoint and this Actor point at the same server.
WO_MLFLOW_TRACKING_URI=https://mlflow.pods.portals.tapis.io

# ---------------------------------------------------------------------------
# Tapis -- service credentials for async Actor invocation (Decision 30)
# ---------------------------------------------------------------------------
# Decision 30: these Actors run async (Celery-queued from WebODM, no request
# in flight by the time the Actor executes), so they cannot use a live
# per-request user JWT the way publish-to-stac's synchronous handler does.
# They need a STORED, REFRESHABLE token -- mirroring the CKAN plugin's own
# existing async-publish pattern (apply_ckan_publish / TapisOAuth2Token in
# the WebODM repo), not a token that expires mid-run. The exact mechanism for
# how that stored token reaches the Actor invocation (embedded in the Actor
# message payload vs. a service-account client the Actor refreshes itself) is
# NOT fully designed yet -- see README "Next steps" item 6. The variables
# below name the pieces WebODM's own settings.py already uses for the
# equivalent purpose (WO_TAPIS_BASE_URL / WO_TAPIS_TENANT_ID), so a real
# implementation isn't inventing new naming.
TAPIS_BASE_URL=https://portals.tapis.io
TAPIS_TENANT_ID=
TAPIS_CLIENT_ID=
TAPIS_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# DSO STAC API (Decision 19 / 23) -- embed-generate only
# ---------------------------------------------------------------------------
# Only consulted when a visit carries a stac_item_id (a genuinely STAC-sourced
# visit, or a webodm-origin visit that has been published -- Decision 20).
# Reads are anonymous; no token needed here. Not used at all by model-train.
STAC_API_URL=https://stacapi.pods.portals.tapis.io/api/v1

# ---------------------------------------------------------------------------
# WebODM -- embed-generate only (Decision 40/41/44)
# ---------------------------------------------------------------------------
# Base URL of the WebODM instance this Actor fetches tiles from (Decision 40's
# WebODM-sourced-visit branch only -- STAC-sourced visits use STAC_API_URL
# above instead, not implemented this increment). Matches WebODM's own WO_URL
# setting for the SAME instance -- e.g. http://localhost:8000 in local dev.
WEBODM_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Clay v1.5 encoder -- embed-generate only
# ---------------------------------------------------------------------------
# Baked into the Docker image as of Decision 39/44 (see Dockerfile) --
# these two ENV values are set THERE, not read from this .env file at
# runtime for a real deployment. Still listed here (a) so local, non-Docker
# runs of embed_generate.main can point at the vendor/ copies directly, and
# (b) to document the exact paths the Dockerfile bakes them at.
CLAY_CHECKPOINT_PATH=/models/clay-v1.5.ckpt
CLAY_MODEL_DIR=/app/vendor/clay-model-src
